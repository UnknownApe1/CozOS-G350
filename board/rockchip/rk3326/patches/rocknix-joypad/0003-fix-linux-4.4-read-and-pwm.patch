Support the Linux 4.4 read API and PWM period type on RK3326.

diff --git a/rocknix-singleadc-joypad.c b/rocknix-singleadc-joypad.c
index b388e9f..b3a505e 100644
--- a/rocknix-singleadc-joypad.c
+++ b/rocknix-singleadc-joypad.c
@@ -26,6 +26,21 @@
 #include <linux/workqueue.h>
 #include <linux/jiffies.h>
 
+/* Linux 4.4 takes the offset by value; emulate the newer position API. */
+static ssize_t joypad_kernel_read(struct file *file, void *buf,
+                                 size_t count, loff_t *pos)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 14, 0)
+	ssize_t ret = kernel_read(file, *pos, buf, count);
+
+	if (ret > 0)
+		*pos += ret;
+	return ret;
+#else
+	return kernel_read(file, buf, count, pos);
+#endif
+}
+
